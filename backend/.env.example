# Environment Variables Configuration

# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
MONGODB_URL=mongodb://localhost:27017

# JWT Tokens
# Generate secure random strings for these (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ACCESS_TOKEN_SECRET=your_access_token_secret_key_here_minimum_32_characters
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=your_refresh_token_secret_key_here_minimum_32_characters
REFRESH_TOKEN_EXPIRY=30d

# Note: In production, set NODE_ENV=production and use secure secrets
